# Copy this file to .env and fill in real values for your run. .env is gitignored.

# Signs the session cookie. Generate with: openssl rand -hex 32
SECRET_KEY=changeme-generate-a-long-random-string

# Demo mode: enables the "Try the demo as..." one-tap logins, the red DEMO
# banner, and the nightly 3am (America/Chicago) data reset. Never set true
# on a deployment with real resident data.
DEMO_MODE=true

# Tow policy: true = an orange-zone car with no valid permit needs
# Board/PMG approval before towing. false = it's just "May be towed".
TOW_APPROVAL_REQUIRED=true

# Guest passes are a PROPOSED feature (pending Board approval) - see
# README. These just bound the demo's behavior.
GUEST_PASS_MAX_HOURS=72

TZ=America/Chicago

# Tow operator shared login code.
TOW_COMPANY_CODE=AWC-2024

# Board/PMG shared admin login.
ADMIN_USERNAME=board
ADMIN_PASSWORD=changeme

# Fixed PIN for every seeded demo unit (DEMO_MODE only - shown directly on
# the resident login screen).
DEMO_RESIDENT_PIN=123456
